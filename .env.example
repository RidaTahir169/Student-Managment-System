# Django Security Settings
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=.railway.app,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Provided automatically by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Celery / Redis Configuration (Optional: Provided automatically if Railway Redis plugin is added)
REDIS_URL=redis://default:password@roundhouse.proxy.rlwy.net:12345
