# Django Security Settings
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=.railway.app,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Reference Railway's PostgreSQL plugin)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Celery / Redis Configuration (Optional: Reference Railway's Redis plugin)
REDIS_URL=${{Redis.REDIS_URL}}
